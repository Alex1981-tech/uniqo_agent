{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "UNIQO Сповіщення",
  "mainBinaryName": "uniqo-notify",
  "version": "0.1.1",
  "identifier": "app.uniqo.notify",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "UNIQO Сповіщення",
        "label": "main",
        "width": 380,
        "height": 600,
        "resizable": false,
        "center": true,
        "visible": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Alex1981-tech/uniqo_agent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMTk4ODZFQjEwMUJFMEQKUldRTnZnR3hib2daMDFVTXQvSnY4U3ExRk1VWHd3RWlPZXZsNWNReG9mTDhackNSTHdMT25HOEwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
